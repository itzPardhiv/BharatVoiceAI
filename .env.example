# ==============================================================================
# BHARATVOICE AI — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env before starting the backend server:
#   cp .env.example .env
#
# IMPORTANT: Never commit your actual .env file or private API keys to GitHub!
# ==============================================================================

# Database Persistence
# Path to the local SQLite database file
DATABASE_PATH=./backend/bharatvoice.db

# Multi-Store API Key Authorization (Optional)
# Format: JSON mapping of {"API_KEY": "STORE_IDENTIFIER"}
# Leave empty for single-store local development without auth headers
BHARATVOICE_STORE_API_KEYS=

# Gnani.ai AI Services Integration (Prisma STT & Timbre TTS)
# Obtain keys from the Gnani.ai developer portal (https://gnani.ai)
# All voice capabilities (speech-to-text and text-to-speech) are powered exclusively by Gnani AI
GNANI_API_KEY=
GNANI_ACCESS_KEY=
GNANI_STT_URL=https://api.vachana.ai/stt/v3
GNANI_TTS_URL=https://api.vachana.ai/api/v1/tts/inference

