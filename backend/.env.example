# ==============================================================================
# BHARATVOICE AI — BACKEND CONFIGURATION
# ==============================================================================

# Database Path
DATABASE_PATH=./bharatvoice.db

# Store API Keys Mapping (JSON or comma-separated pairs)
# Example: {"key-default-123": "DEFAULT", "key-mumbai-456": "STORE_MUMBAI"}
# Leave blank for local development without store-key authentication.
# To enable it, configure a real private mapping in your local .env file.
BHARATVOICE_STORE_API_KEYS=

# Gnani AI Configuration (Prisma STT & Timbre TTS)
# Obtain API keys from Gnani.ai developer portal: https://gnani.ai
GNANI_API_KEY=
GNANI_ACCESS_KEY=
GNANI_STT_URL=https://api.gnani.ai/v1/asr
GNANI_TTS_URL=https://api.gnani.ai/v1/tts

